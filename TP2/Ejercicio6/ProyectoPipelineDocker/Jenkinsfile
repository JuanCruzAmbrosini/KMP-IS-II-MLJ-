pipeline {
    agent any

    environment {
        // Nombre de la imagen Docker generada
        DOCKER_IMAGE_NAME = "catalog-management-api"
        DOCKER_TAG        = "${BUILD_NUMBER}"
        LATEST_TAG        = "latest"
    }

    tools {
        // En Jenkins -> Manage Jenkins -> Tools se puede definir 'maven-3' y 'jdk-17'
        // Si se ejecutan desde el PATH del sistema o contenedor, Jenkins las usará directamente
        maven 'maven-3'
        jdk   'jdk-17'
    }

    options {
        // Limita la retención de builds y muestra timestamps en los logs
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "=========================================================="
                echo " ETAPA 1: CHECKOUT DEL CÓDIGO FUENTE"
                echo "=========================================================="
                // En un proyecto Pipeline configurado desde SCM, 'checkout scm'
                // clona automáticamente la rama y commit correspondiente.
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "=========================================================="
                echo " ETAPA 2: COMPILACIÓN DEL PROYECTO CON MAVEN"
                echo "=========================================================="
                // Compila los archivos fuente Java
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo "=========================================================="
                echo " ETAPA 3: EJECUCIÓN DE PRUEBAS UNITARIAS"
                echo "=========================================================="
                // Ejecuta la suite de pruebas unitarias y de integración
                sh 'mvn test'
            }
            post {
                always {
                    // Publica el reporte de pruebas unitarias generado por Surefire
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo "=========================================================="
                echo " ETAPA 4: EMPAQUETADO JAR Y CONSTRUCCIÓN DE IMAGEN DOCKER"
                echo "=========================================================="
                // Genera el archivo JAR ejecutable antes de construir la imagen Docker
                sh 'mvn package -DskipTests'

                // Construye la imagen Docker utilizando el Dockerfile provisto
                sh "docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} -t ${DOCKER_IMAGE_NAME}:${LATEST_TAG} ."
                
                echo "--> Imagen Docker construida con éxito: ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} y ${DOCKER_IMAGE_NAME}:${LATEST_TAG}"
            }
        }
    }

    post {
        success {
            echo "=========================================================="
            echo " Pipeline finalizado con ÉXITO."
            echo " Artefacto Docker: ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}"
            echo "=========================================================="
        }
        failure {
            echo "=========================================================="
            echo " El Pipeline FALLÓ. Revisa los logs de consola de la etapa que falló."
            echo "=========================================================="
        }
        cleanup {
            echo "Limpiando espacio de trabajo..."
            cleanWs()
        }
    }
}

