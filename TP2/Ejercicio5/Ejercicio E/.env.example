# Variables de Entorno de Configuración - Fudo Resto (TP2 Ejercicio 5)
# Sección 5.3 de PLAN.md

# Servidor Backend Spring Boot & SSL
SERVER_PORT=8443
SSL_KEYSTORE_PATH=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=fudo_ssl_secret_pass_2026
SSL_KEYSTORE_TYPE=PKCS12

# Base de Datos
DB_URL=jdbc:mysql://localhost:3306/fudo_resto_db?useSSL=false&serverTimezone=UTC
DB_USER=fudo_user
DB_PASSWORD=fudo_secure_pass_2026

# Autenticación Delegada Auth0 & JWT RS256
AUTH0_ISSUER_URI=https://dev-fudo-resto.us.auth0.com/
AUTH0_AUDIENCE=https://api.fudo-resto.local/v1
AUTH0_CLIENT_ID=fudo_resto_frontend_client_id
AUTH0_CLIENT_SECRET=fudo_auth0_secret_key_mock

# CORS y Seguridad Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_RESERVAS_PER_MINUTE=5
