{
	"info": {
		"_postman_id": "9bfa5852-5a3d-4c55-8d57-19e09d57a2c1",
		"name": "TP2 - Ejercicio 5 (f): Biblioteca API REST Segura (JWT)",
		"description": "Colección de pruebas automáticas para verificar la seguridad con JWT y Spring Security en la API REST de Biblioteca (Ejercicio 2 'b').",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Intento sin Token (Espera 401 Unauthorized)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/personas",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "personas"]
				}
			},
			"response": []
		},
		{
			"name": "2. Login como Lector (ROLE_USER)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"jwt_user_token\", jsonData.token);",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Token exists\", function () {",
							"    pm.expect(jsonData.token).to.not.be.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"user\",\n    \"password\": \"user123\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/auth/login",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "auth", "login"]
				}
			},
			"response": []
		},
		{
			"name": "3. GET Personas con Token Lector (Espera 200 OK)",
			"request": {
				"method": "GET",
