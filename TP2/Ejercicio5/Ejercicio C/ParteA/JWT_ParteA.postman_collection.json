{
  "info": {
    "name": "Seguridad JWT - Parte A (demo-jwt)",
    "description": "Colección Postman para probar el proyecto Parte A (Spring Boot 3 + Spring Security 6 + JWT - irojascorsico v1.0)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register User (/auth/register)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"irojas@gmail.com\",\n  \"password\": \"123456\",\n  \"firstname\": \"Ivana\",\n  \"lastname\": \"Rojas\",\n  \"country\": \"Argentina\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "2. Login User (/auth/login)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3. Secure Endpoint (/api/v1/demo)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{jwt_token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/demo",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "demo"]
        }
      }
    }
  ]
}

